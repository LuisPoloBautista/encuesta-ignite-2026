PORT=10000
# Copia en Supabase: Connect > Session pooler (puerto 5432).
DATABASE_URL=postgresql://postgres.proyecto:contrasena@host.pooler.supabase.com:5432/postgres
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esto-por-una-contrasena-larga-y-unica
DB_POOL_MAX=5
# Compatibilidad opcional con la exportación anterior basada en token:
# ADMIN_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio
TRUST_PROXY=1

